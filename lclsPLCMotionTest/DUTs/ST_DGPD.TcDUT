  <DUT Name="ST_DGPD" Id="{c4c81621-d2fd-4f66-bab9-769636119a8e}">
    <Declaration><![CDATA[TYPE ST_DGPD :
STRUCT
    {attribute 'pytmc' := '
        pv: RESET
        io: io
    '}
    bReset               : BOOL;

    {attribute 'pytmc' := '
        pv: bMAINTMODE
        io: io
    '}
    bMaintMode     : BOOL;

    {attribute 'pytmc' := '
        pv: SEQENABLE
        io: io
    '}
    bSeqEnable : BOOL := TRUE;
	
    {attribute 'pytmc' := '
        pv: STATE
        io: io
    '}
