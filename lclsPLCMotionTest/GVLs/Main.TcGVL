<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="Main" Id="{91092ac1-148d-4b6b-ba5f-227336fb9434}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	// In-Vacuum Motion
	{attribute 'pytmc':='pv: DREAM:DGPD:MMT:X'}
    {attribute 'TcLinkTo' := '
        .nRawEncoderDINT		:=TIID^Device 1 (EtherCAT)^TMO-DREAM-SMARACT-03^DREAM:DGPD:MMT:X^mode/status/pos/fError TxPDO^Position Actual Value
    '}
    M9 : ST_MotionStage := (
			sName:='DREAM:DGPD:MMT:X',
			nHomingMode:=E_EpicsHomeCmd.AUTOZERO,
			nEnableMode:= ENUM_StageEnableMode.DURING_MOTION,
			bPowerSelf:=TRUE,
			bHardwareEnable:=TRUE
		);
    {attribute 'pytmc':='pv: DREAM:DGPD:MMT:Y'}
    {attribute 'TcLinkTo' := '
        .nRawEncoderDINT		:=TIID^Device 1 (EtherCAT)^TMO-DREAM-SMARACT-03^DREAM:DGPD:MMT:Y^mode/status/pos/fError TxPDO^Position Actual Value
    '}
    M10 : ST_MotionStage := (
				sName:='DREAM:DGPD:MMT:Y',
				nHomingMode:=E_EpicsHomeCmd.AUTOZERO,
				nEnableMode:= ENUM_StageEnableMode.DURING_MOTION,
				bPowerSelf:=TRUE,
				bHardwareEnable:=TRUE
		);

	{attribute 'pytmc':='pv: DREAM:DGPD:MMT:Z'}
    {attribute 'TcLinkTo' := '
        .nRawEncoderDINT		:=TIID^Device 1 (EtherCAT)^TMO-DREAM-SMARACT-03^DREAM:DGPD:MMT:Z^mode/status/pos/fError TxPDO^Position Actual Value
    '}
    M11 : ST_MotionStage := (
				sName:='DREAM:DGPD:MMT:Z',
				nHomingMode:=E_EpicsHomeCmd.AUTOZERO,
				nEnableMode:= ENUM_StageEnableMode.DURING_MOTION,
				bPowerSelf:=TRUE,
				bHardwareEnable:=TRUE
		);
		
	{attribute 'pytmc':='pv: DREAM:DGPD:MMT:RET'}
    {attribute 'TcLinkTo' := '
        .nRawEncoderDINT		:=TIID^Device 1 (EtherCAT)^TMO-DREAM-SMARACT-04^DREAM:DGPD:MMT:RET^mode/status/pos/fError TxPDO^Position Actual Value
    '}
    M12 : ST_MotionStage := (
				sName:='DREAM:DGPD:MMT:RET',
				nHomingMode:=E_EpicsHomeCmd.AUTOZERO,
				nEnableMode:= ENUM_StageEnableMode.DURING_MOTION,
				bPowerSelf:=TRUE,
				bHardwareEnable:=TRUE
		);					


	// SL1K4-SCATTER: 4 Axes
    {attribute 'pytmc' := 'pv: SL1K4:SCATTER:MMS:X1'}
    {attribute 'TcLinkTo' := '
        .nRawEncoderDINT		:=TIID^Device 1 (EtherCAT)^TMO-DREAM-SMARACT-04^DREAM:SLIT:MMT:X1^mode/status/pos/fError TxPDO^Position Actual Value
    '}
    M13: ST_MotionStage := (sName := 'SL3K4:SCATTER:MMT:X1');
	
    {attribute 'pytmc' := 'pv: SL1K4:SCATTER:MMS:X2'}
    {attribute 'TcLinkTo' := '
        .nRawEncoderDINT		:=TIID^Device 1 (EtherCAT)^TMO-DREAM-SMARACT-04^DREAM:SLIT:MMT:X2^mode/status/pos/fError TxPDO^Position Actual Value
    '}
    M14: ST_MotionStage := (sName := 'SL3K4:SCATTER:MMT:X2');
	
    {attribute 'pytmc' := 'pv: SL1K4:SCATTER:MMS:Y1'}
    {attribute 'TcLinkTo' := '
        .nRawEncoderDINT		:=TIID^Device 1 (EtherCAT)^TMO-DREAM-SMARACT-05^DREAM:SLIT:MMT:Y1^mode/status/pos/fError TxPDO^Position Actual Value
    '}
    M15: ST_MotionStage := (sName := 'SL3K4:SCATTER:MMT:Y1');

    {attribute 'pytmc' := 'pv: SL1K4:SCATTER:MMS:Y2'}
    {attribute 'TcLinkTo' := '
        .nRawEncoderDINT		:=TIID^Device 1 (EtherCAT)^TMO-DREAM-SMARACT-05^DREAM:SLIT:MMT:Y2^mode/status/pos/fError TxPDO^Position Actual Value
    '}
    M16: ST_MotionStage := (sName := 'SL3K4:SCATTER:MMT:Y2');

	FB_PMPSJsonTestHelper : FB_PMPSJsonTestHelper;
	astBeam: ARRAY[0..2] OF ST_DbStateParams;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>