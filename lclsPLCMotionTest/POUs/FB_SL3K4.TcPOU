<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SL3K4" Id="{dec1d628-e499-461c-bd3b-fc39c76517dd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SL3K4
VAR_IN_OUT
	// The motors to move.
 	stTopBlade       : ST_MotionStage;
    stBottomBlade    : ST_MotionStage;
    stNorthBlade     : ST_MotionStage;
    stSouthBlade     : ST_MotionStage;
 	// The arbiter to request beam conditions from.
    fbArbiter            : FB_Arbiter;
	// The fast fault output to fault to.
    fbFFHWO              : FB_HardwareFFOutput;
END_VAR

VAR_INPUT
    bFileReaderBusy  : BOOL;
    bFileReaderError : BOOL;
    sTransitionKey   : STRING;
    // Set this to TRUE to enable position limit checks, or FALSE to disable them.
    bEnableDriftCheck : BOOL := TRUE;
    fDriftTolerance   : LREAL := 0.003; 
	bEnableBeamParams : BOOL := TRUE;
    // Set this to TRUE to re-read the loaded database immediately (useful for debug)
    bReadDBNow: BOOL;
END_VAR

VAR
    fbPerMotorFFO        : FB_PerMotorFFOND;
    fbEncErrorFFO        : FB_EncErrorFFO;
	fbMiscStatesErrorFFO : FB_MiscStatesErrorFFO;
    ffDriftFFO           : FB_FastFault;
    ffProgrammerError    : FB_FastFault;
	fbSL3K4BPTM : FB_SL3K4BPTM;
 	fbMotionClearAsserts: FB_MotionClearAsserts;

    //eSL3K4State          : E_SL3K4State := E_SL3K4State.MAINTENANCE;
    {attribute 'pytmc' := 'pv: SL3K4:STATE'}
    eReqState: UINT;
    nPrevMode            : E_SL3K4State := E_SL3K4State.NORMAL;
    astMotionStage       : ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF ST_MotionStage;
    abBladeEnable        : ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF BOOL;
    stMaintenanceGoal : ST_DbStateParams;
    stNormalGoal      : ST_DbStateParams;
    stTransitionGoal  : ST_DbStateParams;
    bDBStatesLoaded   : BOOL := FALSE;
    bSafeToMove          : BOOL;
    bLocked              : BOOL;
    bMaintenanceActive   : BOOL;
    bProgrammerError     : BOOL;
    sStatusMsg           : STRING;
    bAnybladeError       : BOOL;
    bArbiterError        : BOOL;
    nBlades              : UINT;
    nActiveMotorCount    : UINT := 4;

    fbSL3K4ReadPMPSDB    : FB_SL3K4ReadPMPSDB;
    sDeviceName          : STRING := 'SL3K4';

    stGoalParams         : ST_DbStateParams;
    stTransParams        : ST_DbStateParams;

    bDBReloadRequested   : BOOL := TRUE; 
    bDBReloadNow         : BOOL := FALSE;
    bReadNow             : BOOL := FALSE;

    // BPTM simulation support
    bDone               : BOOL;
    bDriftFF            : BOOL;
    bLastTransAuth      : BOOL := FALSE;
    bEnable             : BOOL;
    tArbiterTimeout     : TIME := T#3s;
    bMoveOnArbiterTimeout : BOOL := TRUE;
    bResetBPTMTimeout   : BOOL := FALSE;
    bRetry              : BOOL := FALSE;
    bAtState            : BOOL := TRUE;
    bInternalAuth       : BOOL := FALSE;
    bArbiterTimeout     : BOOL := FALSE;

    fDrift              : LREAL;
    allAxesIdle         : BOOL;
    axis                : INT;
    i                   : DINT;
    bGoalIsMaintenance  : BOOL := FALSE;
    bGoalIsNormal       : BOOL := FALSE;
	bFoundTransition: BOOL;
	bFoundGoal: BOOL;

	fbLogger : FB_LogMessage := (eSubsystem:=E_SubSystem.MOTION);
	eSevr: LCLS_General.TcEventSeverity;
    sLastStatusMsg : STRING := '';
    eLastSevr : TcEventSeverity := TcEventSeverity.Info;
	bTransitionAuthorized: BOOL;
	rtEnable: R_TRIG;
	nGoalAtClear: UINT;
	rtUpdateDBState : R_TRIG;
	bFoundNormal: BOOL;
	bFoundMaintenance: BOOL;
END_VAR

VAR_OUTPUT
    {attribute 'pytmc' := 'pv: STATE'}
    stPMPSEpicsToPlc     : ST_StatePMPSEpicsToPlc;
    // The PMPS database lookup associated with the current position state.
    stDbStateParams: ST_DbStateParams;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// --- Assign 4-blade references, every scan ---
astMotionStage[1] := stTopBlade;
astMotionStage[2] := stBottomBlade;
astMotionStage[3] := stNorthBlade;
astMotionStage[4] := stSouthBlade;

// --- PMPS DB Read / safety check (with reload logic)
fbSL3K4ReadPMPSDB(
	fbFFHWO := fbFFHWO,
    bFileReaderError := bFileReaderError,
    bFileReaderBusy  := bFileReaderBusy,
    sDeviceName      := sDeviceName,
    sTransitionKey   := sTransitionKey,
    jsonDoc          := PMPS_GVL.BP_jsonDoc
);

bProgrammerError := nActiveMotorCount <> UPPER_BOUND(astMotionStage, 1);

IF NOT fbSL3K4ReadPMPSDB.bStatesReady THEN
    FOR nBlades := 1 TO nActiveMotorCount DO
        astMotionStage[nBlades].bPowerSelf := FALSE;
        astMotionStage[nBlades].bUserEnable := FALSE;
        astMotionStage[nBlades].nBrakeMode := ENUM_StageBrakeMode.NO_BRAKE;
        abBladeEnable[nBlades] := FALSE;
    END_FOR
    bSafeToMove   := FALSE;
    bLocked       := TRUE;
    sStatusMsg    := 'PMPS parameter DB not loaded. Axes locked!';
    RETURN;
END_IF


// --- Parameter extraction by state name (robust, no index reliance) ---
rtUpdateDBState(CLK := fbSL3K4ReadPMPSDB.bStatesReady);

IF rtUpdateDBState.Q THEN
    // Clear found flags
    bFoundTransition := FALSE;
    bFoundNormal := FALSE;
    bFoundMaintenance := FALSE;

    FOR i := 0 TO UPPER_BOUND(fbSL3K4ReadPMPSDB.astDbStateParams, 1) DO
        IF fbSL3K4ReadPMPSDB.astDbStateParams[i].sPmpsState = sTransitionKey THEN
			stTransitionGoal := fbSL3K4ReadPMPSDB.astDbStateParams[i];
  			bFoundTransition := TRUE;
		ELSIF 	fbSL3K4ReadPMPSDB.astDbStateParams[i].sPmpsState = 'MAINTENANCE' THEN
			stMaintenanceGoal := fbSL3K4ReadPMPSDB.astDbStateParams[i];
			bFoundMaintenance := TRUE;
		ELSIF 	fbSL3K4ReadPMPSDB.astDbStateParams[i].sPmpsState = 'NORMAL' THEN
                stNormalGoal := fbSL3K4ReadPMPSDB.astDbStateParams[i];
                bFoundNormal := TRUE;		
		END_IF
    END_FOR

    // Final check
    IF NOT (bFoundTransition AND bFoundNormal AND bFoundMaintenance) THEN
        sStatusMsg := 'Error: Required PMPS state not found in DB!';
        bProgrammerError := TRUE;
    ELSE
        bDBStatesLoaded := TRUE;
    END_IF
END_IF

IF bDBStatesLoaded THEN
    IF eReqState = E_SL3K4State.MAINTENANCE THEN
        stGoalParams := stMaintenanceGoal;
    ELSIF eReqState = E_SL3K4State.NORMAL THEN
        stGoalParams := stNormalGoal;
    END_IF
    stTransParams := stTransitionGoal;
END_IF


ffProgrammerError(
    i_xOK := NOT bProgrammerError,
    i_xAutoReset := TRUE,
    i_DevName := sDeviceName,
    i_Desc := 'Required PMPS state not found in DB',
    i_TypeCode := E_MotionFFType.INTERNAL_ERROR,
    io_fbFFHWO := fbFFHWO
);
// --- BPTM arbitration and error fast faulting ---
bEnable :=  eReqState<>0 AND NOT bProgrammerError AND stPMPSEpicsToPlc.bArbiterEnabled AND bEnableBeamParams;
rtEnable(CLK:=bEnable);

fbSL3K4BPTM(
    fbArbiter      := fbArbiter,
    fbFFHWO        := fbFFHWO,
	sDeviceName    := sDeviceName,
    stGoalParams   := stGoalParams,
    stTransParams  := stTransParams,
    bEnable        := bEnable,
	bRetry		   := rtEnable.Q AND nGoalAtClear = eReqState,
	bTransitionAuthorized=>	bTransitionAuthorized
);

fbMotionClearAsserts(
    astDbStateParams:=fbSL3K4ReadPMPSDB.astDbStateParams,
    fbArbiter:=fbArbiter,
    bExecute:=NOT fbSL3K4BPTM.bEnable,
);
IF fbMotionClearAsserts.bExecute THEN
    nGoalAtClear := eReqState;
END_IF

// --- Blade error aggregation
bAnybladeError := FALSE;
FOR nBlades := 1 TO nActiveMotorCount DO
    IF astMotionStage[nBlades].bError THEN bAnybladeError := TRUE; END_IF
END_FOR

// --- Safe-to-move logic as per BPTM best practice
bSafeToMove := NOT bTransitionAuthorized AND fbSL3K4BPTM.bDone AND NOT bAnybladeError;
bLocked     := NOT bSafeToMove;

// --- Enable/locking and deadband drift-fast-fault logic
bDriftFF := FALSE;
FOR nBlades := 1 TO nActiveMotorCount DO
    CASE eSL3K4State OF

        E_SL3K4State.NORMAL:
            abBladeEnable[nBlades] := FALSE;
            astMotionStage[nBlades].bPowerSelf := FALSE;
            astMotionStage[nBlades].bUserEnable := FALSE;
            astMotionStage[nBlades].nBrakeMode := ENUM_StageBrakeMode.NO_BRAKE;
			IF bEnableDriftCheck THEN
				fDrift := ABS(astMotionStage[nBlades].axis.NcToPlc.ActPos - astMotionStage[nBlades].fPosition);
				IF fDrift > fDriftTolerance THEN
					bDriftFF := TRUE;
					sStatusMsg := CONCAT(astMotionStage[nBlades].sName, ' drifted out of 3um deadband in normal mode');
					astMotionStage[nBlades].sCustomErrorMessage := sStatusMsg;
				END_IF			
			END_IF


        E_SL3K4State.MAINTENANCE:
            IF bSafeToMove THEN
                astMotionStage[nBlades].bPowerSelf := TRUE;
                astMotionStage[nBlades].bUserEnable := TRUE;
                astMotionStage[nBlades].nBrakeMode := ENUM_StageBrakeMode.NO_BRAKE;
                abBladeEnable[nBlades] := TRUE;
            ELSE
                astMotionStage[nBlades].bPowerSelf := FALSE;
                astMotionStage[nBlades].bUserEnable := FALSE;
                astMotionStage[nBlades].nBrakeMode := ENUM_StageBrakeMode.NO_BRAKE;
                abBladeEnable[nBlades] := FALSE;
            END_IF

        ELSE
            astMotionStage[nBlades].bPowerSelf := FALSE;
            astMotionStage[nBlades].bUserEnable := FALSE;
            astMotionStage[nBlades].nBrakeMode := ENUM_StageBrakeMode.NO_BRAKE;
            abBladeEnable[nBlades] := FALSE;
    END_CASE
END_FOR

IF bEnableBeamParams THEN
    fbMiscStatesErrorFFO.stCurrentBeamReq := fbSL3K4ReadPMPSDB.astDbStateParams[eSL3K4State].stBeamParams;
ELSE
    fbMiscStatesErrorFFO.stCurrentBeamReq := PMPS_GVL.cstFullBeam;
END_IF

fbMiscStatesErrorFFO(
    fbArbiter:=fbArbiter,
    fbFFHWO:=fbFFHWO,
    sDeviceName:=sDeviceName,
    bKnownState:=eSL3K4State > 0,
    nTransitionID:=fbSL3K4ReadPMPSDB.astDbStateParams[0].nRequestAssertionID,
);

// --- Per-motor fast fault, drift, and programmer error
fbPerMotorFFO(
    astMotionStage := astMotionStage,
    fbFFHWO := fbFFHWO,
    nActiveMotorCount := nActiveMotorCount,
    sDeviceName := sDeviceName
);

ffDriftFFO(
    i_xOK := NOT bDriftFF,
    i_xAutoReset := TRUE,
    i_DevName := sDeviceName,
    i_Desc := 'locked out blades drifting beyond allowable delta',
    i_TypeCode := E_MotionFFType.INTERNAL_ERROR,
    io_fbFFHWO := fbFFHWO
);

// --- Status message and logging
IF bDriftFF OR bProgrammerError THEN
    sStatusMsg := 'Device fast faulted (blades, encoder, or config error)';
    eSevr := TcEventSeverity.Critical;
ELSIF bGoalIsMaintenance THEN
    sStatusMsg := 'Maintenance: PMPS safe, axes enabled for manual scatter/homing.';
    eSevr := TcEventSeverity.Info;
ELSE
    sStatusMsg := 'Normal: Axes locked for PMPS protection.';
    eSevr := TcEventSeverity.Info;
END_IF

// --- Log only on change
IF (sStatusMsg <> sLastStatusMsg) THEN
    fbLogger(
        sMsg  := sStatusMsg,
        eSevr := eSevr
    );
    sLastStatusMsg := sStatusMsg;
    eLastSevr := eSevr;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>