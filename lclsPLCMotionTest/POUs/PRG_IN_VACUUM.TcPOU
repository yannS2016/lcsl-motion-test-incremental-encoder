  <POU Name="PRG_IN_VACUUM" Id="{8c8a4af2-8a7c-4f25-948f-bede85609ff3}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_IN_VACUUM
VAR
    bInit: BOOL := TRUE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bInit THEN
    // --- X axis ---
//     MAIN.M9.bHardwareEnable := TRUE;
